{
  "rewrites": [
    {
      "source": "/api/auth-users",
      "destination": "/api/auth-users.js"
    },
    {
      "source": "/api/card-config",
      "destination": "/api/card-config.js"
    },
    {
      "source": "/api/wishes",
      "destination": "/api/wishes.js"
    },
    {
      "source": "/api/cloud-sync",
      "destination": "/api/cloud-sync.js"
    },
    {
      "source": "/api/upload-media",
      "destination": "/api/upload-media.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js",
      "has": [
        {
          "type": "query",
          "key": "to"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js",
      "has": [
        {
          "type": "query",
          "key": "guest"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js",
      "has": [
        {
          "type": "query",
          "key": "name"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Zalo|Twitterbot|Pinterest|Google.*snippet|WhatsApp|TelegramBot|Discordbot).*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
